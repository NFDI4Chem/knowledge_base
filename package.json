{
	"name": "nfdi-4-chem-knowledge-base",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"docusaurus": "docusaurus",
		"start": "docusaurus start",
		"build": "docusaurus build",
		"pw:install": "playwright install chromium",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:update": "playwright test --update-snapshots",
		"test:e2e:visual": "playwright test tests/e2e/visual-pages.spec.ts",
		"test:e2e:visual:update": "playwright test tests/e2e/visual-pages.spec.ts --update-snapshots",
		"test": "npm run test:content",
		"test:all": "npm run test:format && npm run test:content && npm run test:js",
		"test:format": "prettier --check \"**/*.{js,jsx,ts,tsx,md,mdx,json,css,yml,yaml}\"",
		"test:content": "npm run validate-content",
		"test:format:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,md,mdx,json,css,yml,yaml}\"",
		"test:js": "eslint .",
		"test:js:fix": "eslint . --fix",
		"swizzle": "docusaurus swizzle",
		"deploy": "docusaurus deploy",
		"clear": "docusaurus clear",
		"serve": "docusaurus serve",
		"write-translations": "docusaurus write-translations",
		"write-heading-ids": "docusaurus write-heading-ids",
		"crowdin": "crowdin",
		"validate-content": "node tests/content/validate-content.js",
		"test:ci": "npm run write-translations && npm run crowdin download && npm run validate-content && npm run build"
	},
	"dependencies": {
		"@docusaurus/core": "^3.10.2",
		"@docusaurus/faster": "^3.10.2",
		"@docusaurus/plugin-sitemap": "^3.10.2",
		"@docusaurus/preset-classic": "^3.10.2",
		"@mdx-js/react": "^3.1.1",
		"clsx": "^2.1.1",
		"docusaurus-plugin-matomo": "^0.0.8",
		"moment": "^2.30.1",
		"nuka-carousel": "^8.2.0",
		"prism-react-renderer": "^2.4.1",
		"react": "^19",
		"react-dom": "^19",
		"react-tagcloud": "^2.3.3",
		"use-immer": "^0.11.0",
		"video-privacy": "^1.2.0"
	},
	"devDependencies": {
		"@crowdin/cli": "^5.0.2",
		"@docusaurus/module-type-aliases": "^3.10.2",
		"@docusaurus/types": "^3.10.2",
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.63.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"glob": "^13.0.6",
		"globals": "^17.12.0",
		"gray-matter": "^4.0.3",
		"lint": "^1.2.2",
		"prettier": "^3.9.6",
		"typescript-eslint": "^8.70.0"
	},
	"browserslist": {
		"production": [
			">0.5%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 3 chrome version",
			"last 3 firefox version",
			"last 5 safari version"
		]
	},
	"engines": {
		"node": ">=18.0"
	},
	"allowScripts": {
		"@swc/core@1.16.1": true,
		"core-js@3.50.0": true
	}
}
